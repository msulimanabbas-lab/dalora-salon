# PostgreSQL connection string
DATABASE_URL=postgres://user:password@host:5432/dalora
# Long random string (e.g. `openssl rand -base64 48`). Changing it signs everyone out.
AUTH_SECRET=change-me
# A private test site without SMS: everyone logs in with their phone + this 6-digit code.
TEST_ACCESS_CODE=
# Leave SMS_PROVIDER empty until an SMS provider is set up.
SMS_PROVIDER=
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=

# Support WhatsApp number shown on the help page, e.g. 9665XXXXXXXX (optional)
SUPPORT_WHATSAPP=
# Set to 1 to turn off the public demo at /demo
DEMO_DISABLED=
